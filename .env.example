# ── Core ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# 32+ random chars. Used for session/secret encryption. Never reuse.
APP_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data/barifollow.db
# Set to 1 when behind Railway/Caddy/nginx so client IPs are read correctly.
TRUST_PROXY=0
BASE_URL=http://localhost:3000

# ── First admin (created on first boot) ─────────────────────────────────
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=BariFollow Admin

# ── UPI (manual verification flow) ──────────────────────────────────────
UPI_ID=barifollow@upi
UPI_NAME=BariFollow
SUPPORT_WHATSAPP=917877311536

# ── Order engine ────────────────────────────────────────────────────────
# Auto-poll open provider orders every 2 minutes (1/0)
AUTO_SYNC=1
# Dev/demo only: seed a mock provider so orders complete without credentials.
# Never enable in production.
SEED_MOCK=0
